# 依赖
dev/node_modules/

# WorkBuddy 会话数据（本机会话元数据，不入库）
.workbuddy/

# ---------------------------------------------------------------------
# .cache/ —— 所有中间文件统一放这里，根目录保持干净
#
# 约定（用户要求）：
#   以后构建产物、临时文件、测试脚本产物一律进 .cache/，
#   不要再往项目根目录扔 build-* / dist-* 之类的目录。
#
#   .cache/build/          构建产物（electron-builder 输出）
#   .cache/build/mac/      macOS zip
#   .cache/electron-mac/   Electron mac 运行时缓存
#   .cache/icons/          图标生成的临时文件
#   .cache/trash/          待删除暂存区（确认后整目录删）
#   .cache/scratch/        一次性脚本与调试产物
# ---------------------------------------------------------------------
.cache/

# 历史遗留的构建目录名（旧版本用过），换到 .cache/ 之前留下的
build-output/
build-out/
build-out-*/
win-build-*/
out-*/
dist-out/
dist/
release/

# 图标生成产物
# 注意：icon.icns / icon.ico / icon-256.png 是打包的【必需输入】，必须入库。
#  - icon.icns  ：macOS 打包的图标
#  - icon.ico   ：Windows 打包的图标
#  - icon-256.png：package.json 的 extraResources 会把它拷进应用
# gen-icons.js 依赖 Windows 的 Edge 生成 PNG，Mac 上跑不了，
# 所以这些预生成产物要随仓库分发，否则 clone 后打包会因缺图标失败。
# 其余尺寸的 PNG 与 base64 仅供 Windows 内部使用，不入库。
dev/build/icons/icon-*.png
dev/build/icons/*.base64.txt
!dev/build/icons/icon-256.png

# 渲染层 esbuild 产物
dev/src/renderer/app.bundle.js
dev/src/renderer/update.bundle.js

# 设计走查临时文件
dev/src/renderer/_preview.html
dev/src/renderer/_shot.html
dev/src/renderer/_seed.js
dev/src/renderer/_clear.js

# 系统
.DS_Store
Thumbs.db
*.log

# 历史遗留的待删除目录（已迁至 .cache/trash/，云盘锁定删不掉时残留）
_to_delete/

# electron-updater 开发模式的更新配置（每次打包后要重生成，不入库）
dev/dev-app-update.yml
dev/scripts/dev-app-update.yml

# Compiled native Launch Services helper
dev/build/mac/
