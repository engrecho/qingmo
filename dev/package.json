{
  "name": "qingmo",
  "version": "1.6.0",
  "description": "轻墨 QingMo — 简洁轻量的跨平台 Markdown 编辑器",
  "main": "src/main/main.js",
  "author": "王君龙",
  "license": "MIT",
  "scripts": {
    "build:renderer": "node scripts/build-renderer.js",
    "start": "npm run build:renderer && electron .",
    "dev": "npm run build:renderer && electron .",
    "pack:win": "npm run build:renderer && electron-builder --win",
    "pack:win:safe": "node scripts/pack.js win",
    "pack:mac": "npm run build:renderer && electron-builder --mac",
    "pack:mac:safe": "node scripts/pack.js mac",
    "pack:mac:dmg": "npm run build:renderer && electron-builder --mac dmg",
    "pack:mac:zip": "npm run build:renderer && electron-builder --mac zip",
    "pack": "npm run build:renderer && electron-builder --win --mac",
    "pack:mac-x": "node scripts/mac/build-mac.js",
    "mac:fetch": "node scripts/mac/fetch-runtime.js",
    "export:mac": "node scripts/export-for-mac.js",
    "cache:clean": "node scripts/clean-cache.js",
    "publish:win": "node scripts/publish.js win",
    "publish:mac": "node scripts/publish.js mac && node scripts/verify-mac.js",
    "publish": "node scripts/publish.js all",
    "verify:asar": "node scripts/verify-asar.js",
    "test:live-edit": "node scripts/test-live-edit.js",
    "test:dom": "node scripts/test-dom.js",
    "test:assoc": "electron scripts/test-file-association.js",
    "verify:ui": "electron scripts/verify-ui.js",
    "gen:logo": "electron scripts/gen-logo-icons.js",
    "check:bundle": "node scripts/check-bundle-fresh.js",
    "test:edit": "electron scripts/verify-edit.js",
    "test:all": "npm run test:core && npm run test:live-edit && npm run test:dom && npm run test:edit && npm run test:keys && npm run test:ime && npm run test:real-input && npm run test:toggle && npm run test:shortcuts && npm run test:log-loop && npm run test:log && npm run test:update && npm run test:update-fallback && npm run test:ui-changes",
    "verify:mac": "node scripts/verify-mac.js",
    "test:core": "node scripts/test-editor-core.js",
    "test:keys": "electron scripts/verify-keys.js",
    "test:log": "electron scripts/verify-log.js",
    "test:open": "electron scripts/verify-open-file.js",
    "test:matrix": "electron scripts/syntax-matrix.js",
    "test:update": "electron scripts/verify-update.js",
    "test:update-fallback": "electron scripts/verify-update-fallback.js",
    "test:auto-update": "electron scripts/verify-auto-update-runtime.js",
    "verify:auto-update": "node scripts/verify-auto-update.js",
    "test:ime": "electron scripts/verify-ime.js",
    "test:real-input": "electron scripts/verify-real-input.js",
    "test:toggle": "electron scripts/verify-md-keymap-toggle.js",
    "test:log-loop": "electron scripts/verify-log-loop.js",
    "test:ui-changes": "electron scripts/verify-ui-changes.js",
    "test:shortcuts": "electron scripts/verify-shortcuts.js"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.6.0",
    "@codemirror/lang-markdown": "^6.2.5",
    "@codemirror/language": "^6.10.2",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.5.6",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.28.0",
    "@lezer/highlight": "^1.2.0",
    "dompurify": "^3.1.5",
    "electron-updater": "^6.8.11",
    "esbuild": "^0.28.2",
    "marked": "^14.0.0"
  },
  "build": {
    "appId": "cn.bajiaolu.qingmo",
    "productName": "轻墨",
    "directories": {
      "output": "../dist"
    },
    "files": [
      "src/main/**/*",
      "src/renderer/index.html",
      "src/renderer/styles/**/*",
      "src/renderer/app.bundle.js",
      "src/renderer/update.bundle.js",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icons/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icons/icon.icns",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "entitlements": null,
      "extendInfo": {
        "CFBundleDisplayName": "轻墨",
        "CFBundleName": "轻墨",
        "NSHumanReadableCopyright": "MIT License"
      },
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdown",
          "mkd",
          "mkdn",
          "mdtxt",
          "mdtext"
        ],
        "name": "Markdown",
        "description": "Markdown 文档",
        "mimeType": "text/markdown",
        "role": "Editor",
        "rank": "Owner",
        "isPackage": false,
        "icon": "build/icons/icon-256.png"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "轻墨",
      "installerLanguages": [
        "zh_CN"
      ],
      "language": 2052,
      "artifactName": "QingMo-${version}-win-setup.${ext}",
      "differentialPackage": true
    },
    "extraResources": [
      {
        "from": "build/icons",
        "to": "icons",
        "filter": [
          "icon-256.png"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "engrecho",
        "repo": "qingmo",
        "channel": "latest"
      }
    ],
    "portable": {
      "artifactName": "QingMo-${version}-win-portable.${ext}"
    }
  },
  "productName": "轻墨"
}
